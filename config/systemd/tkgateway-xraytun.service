[Unit]
Description=TK Gateway XRay TUN for 192.168.50.0/24
After=network-online.target xray.service
Wants=network-online.target
Requires=xray.service

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/tkgateway-xraytun-up.sh
ExecStart=/usr/local/bin/tun2socks -device tun://xraytun -proxy socks5://127.0.0.1:10808 -loglevel info
ExecStopPost=/usr/local/sbin/tkgateway-xraytun-down.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
