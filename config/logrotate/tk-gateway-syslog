/var/log/tkgateway/fritzbox.log {
    size 10M
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root www-data
    su root root
    postrotate
        /bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}

/var/log/tkgateway/vpn-watchdog.log {
    size 10M
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root www-data
    su root root
}
